{
  "name": "prestashop-registration-tests",
  "version": "1.0.0",
  "description": "Playwright + JavaScript automation of the PrestaShop demo customer registration flow",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
